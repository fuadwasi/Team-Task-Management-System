@model SiteScopeConfigurationModel

@inject AssetForge.Core.IWebHelper webHelper

@{
    var returnUrl = webHelper.GetRawUrl(Context.Request);
    var sites = await Model.Sites.SelectAwait(async site => new SelectListItem
    {
        Text = site.Name,
        Value = Url.Action("ChangeSiteScopeConfiguration", "Setting", new { siteid = site.Id, returnUrl }, webHelper.GetCurrentRequestProtocol()),
        Selected = site.Id.Equals(Model.SiteId)
    }).ToListAsync();
    sites.Insert(0, new SelectListItem
    {
        Text = T("Admin.Configuration.Settings.SiteScope.AllSites").Text,
        Value = Url.Action("ChangeSiteScopeConfiguration", "Setting", new { siteid = 0, returnUrl }, webHelper.GetCurrentRequestProtocol()),
        Selected = 0.Equals(Model.SiteId)
    });
}

<div class="form-group row">
    <div class="col-md-12 site-scope-configuration">
        <div class="label-wrapper">
            <label class="col-form-label">
                @T("Admin.Configuration.Settings.SiteScope")
            </label>
        </div>
        <ix-select asp-for-name="site-scope-configuration" asp-items="@sites" onchange="setLocation(this.value);" style="width: auto;min-width: 300px;" />
        @if (Model.SiteId > 0)
        {
            <div class="checkbox">
                <label>
                    <input type="checkbox" onclick="checkAllOverriddenSiteValue(this)">
                    <b>@T("Admin.Configuration.Settings.SiteScope.CheckAll")</b> @T("Admin.Configuration.Settings.SiteScope.CheckAll.Hint")
                </label>
            </div>
        }
    </div>
</div>