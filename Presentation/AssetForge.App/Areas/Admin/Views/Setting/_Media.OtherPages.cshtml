@model MediaSettingsModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="CatelogThumbPictureSize_OverrideForSite" asp-input="CatelogThumbPictureSize" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="CatelogThumbPictureSize" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="CatelogThumbPictureSize" />
            <span asp-validation-for="CatelogThumbPictureSize"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="AvatarPictureSize_OverrideForSite" asp-input="AvatarPictureSize" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="AvatarPictureSize" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="AvatarPictureSize" />
            <span asp-validation-for="AvatarPictureSize"></span>
        </div>
    </div>
</div>