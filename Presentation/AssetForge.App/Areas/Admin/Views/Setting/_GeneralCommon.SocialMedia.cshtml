@model GeneralCommonSettingsModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="SiteInformationSettings.FacebookLink_OverrideForSite" asp-input="SiteInformationSettings.FacebookLink" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="SiteInformationSettings.FacebookLink" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="SiteInformationSettings.FacebookLink" />
            <span asp-validation-for="SiteInformationSettings.FacebookLink"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="SiteInformationSettings.TwitterLink_OverrideForSite" asp-input="SiteInformationSettings.TwitterLink" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="SiteInformationSettings.TwitterLink" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="SiteInformationSettings.TwitterLink" />
            <span asp-validation-for="SiteInformationSettings.TwitterLink"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="SiteInformationSettings.YoutubeLink_OverrideForSite" asp-input="SiteInformationSettings.YoutubeLink" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="SiteInformationSettings.YoutubeLink" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="SiteInformationSettings.YoutubeLink" />
            <span asp-validation-for="SiteInformationSettings.YoutubeLink"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="SiteInformationSettings.InstagramLink_OverrideForSite" asp-input="SiteInformationSettings.InstagramLink" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="SiteInformationSettings.InstagramLink" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="SiteInformationSettings.InstagramLink" />
            <span asp-validation-for="SiteInformationSettings.InstagramLink"></span>
        </div>
    </div>
</div>