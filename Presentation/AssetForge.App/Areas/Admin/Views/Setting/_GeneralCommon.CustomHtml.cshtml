@model GeneralCommonSettingsModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="CustomHtmlSettings.HeaderCustomHtml_OverrideForSite" asp-input="CustomHtmlSettings.HeaderCustomHtml" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="CustomHtmlSettings.HeaderCustomHtml" />
        </div>
        <div class="col-md-9">
            <ix-textarea asp-for="CustomHtmlSettings.HeaderCustomHtml" />
            <span asp-validation-for="CustomHtmlSettings.HeaderCustomHtml"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="CustomHtmlSettings.FooterCustomHtml_OverrideForSite" asp-input="CustomHtmlSettings.FooterCustomHtml" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="CustomHtmlSettings.FooterCustomHtml" />
        </div>
        <div class="col-md-9">
            <ix-textarea asp-for="CustomHtmlSettings.FooterCustomHtml" />
            <span asp-validation-for="CustomHtmlSettings.FooterCustomHtml"></span>
        </div>
    </div>
</div>