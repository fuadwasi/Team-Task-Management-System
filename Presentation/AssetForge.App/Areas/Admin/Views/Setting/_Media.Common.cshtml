@model MediaSettingsModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <ix-label asp-for="PicturesSitedIntoDatabase" />
        </div>
        <div class="col-md-1">
            <div class="form-text-row">
                @if (Model.PicturesSitedIntoDatabase)
                {
                    @T("Admin.Configuration.Settings.Media.PicturesSitedIntoDatabase.Database")
                }
                else
                {
                    @T("Admin.Configuration.Settings.Media.PicturesSitedIntoDatabase.FileSystem")
                }
            </div>
        </div>
        <div class="col-md-8">
            <button type="submit" id="change-picture-storage" name="change-picture-storage" class="btn btn-primary">
                @T("Admin.Configuration.Settings.Media.PicturesSitedIntoDatabase.Change")
            </button>
            <ix-action-confirmation asp-button-id="change-picture-storage" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-9 offset-md-3">
        </div>
    </div>
    <div class="form-group row advanced-setting">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="MaximumImageSize_OverrideForSite" asp-input="MaximumImageSize" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="MaximumImageSize" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="MaximumImageSize" />
            <span asp-validation-for="MaximumImageSize"></span>
        </div>
    </div>
    <div class="form-group row advanced-setting">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="MultipleThumbDirectories_OverrideForSite" asp-input="MultipleThumbDirectories" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="MultipleThumbDirectories" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="MultipleThumbDirectories" />
            <span asp-validation-for="MultipleThumbDirectories"></span>
        </div>
    </div>
    <div class="form-group row advanced-setting">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="DefaultImageQuality_OverrideForSite" asp-input="DefaultImageQuality" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="DefaultImageQuality" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="DefaultImageQuality" />
            <span asp-validation-for="DefaultImageQuality"></span>
        </div>
    </div>
    <div class="form-group row advanced-setting">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="DefaultPictureZoomEnabled_OverrideForSite" asp-input="DefaultPictureZoomEnabled" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="DefaultPictureZoomEnabled" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="DefaultPictureZoomEnabled" />
            <span asp-validation-for="DefaultPictureZoomEnabled"></span>
        </div>
    </div>
    <div class="form-group row advanced-setting">
        <div class="col-md-3">
            <ix-override-site-checkbox asp-for="AllowSVGUploads_OverrideForSite" asp-input="AllowSVGUploads" asp-site-scope="@Model.ActiveSiteScopeConfiguration" />
            <ix-label asp-for="AllowSVGUploads" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="AllowSVGUploads" />
            <span asp-validation-for="AllowSVGUploads"></span>
        </div>
    </div>
</div>