@model LayoutSearchModel

@{    
    //page title
    ViewBag.PageTitle = T("Admin.ContentManagement.Layouts").Text;
    //active menu item (system name)
    AssetForgeHtml.SetActiveMenuItemSystemName("Layouts");
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Admin.ContentManagement.Layouts")
    </h1>
    <div class="float-right">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-square"></i>
            @T("Admin.Common.AddNew")
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
    <div class="form-horizontal">
        <div class="cards-group">
            <div class="card card-default">
                <div class="card-body">
                    @await Html.PartialAsync("Table", new DataTablesModel
                    {
                        Name = "widgets-grid",
                        UrlRead = new DataUrl("List", "Layout", null),
                        UrlUpdate = new DataUrl("LayoutUpdate", "Layout", null),
                        Length = Model.PageSize,
                        LengthMenu = Model.AvailablePageSizes,
                        ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(LayoutModel.Name))
                                {
                                    Title = T("Admin.ContentManagement.Layouts.Fields.Name").Text,
                                    Width = "250"
                                },
                                new ColumnProperty(nameof(LayoutModel.TemplateName))
                                {
                                    Title = T("Admin.ContentManagement.Layouts.Fields.Template").Text,
                                    Width = "250"
                                },
                                new ColumnProperty(nameof(LayoutModel.DisplayOrder))
                                {
                                    Title = T("Admin.ContentManagement.Layouts.Fields.DisplayOrder").Text,
                                    Width = "100",
                                    ClassName = AssetForgeColumnClassDefaults.CenterAll,
                                    Editable = true,
                                    EditType = EditType.Number
                                },
                                new ColumnProperty(nameof(LayoutModel.IsDefault))
                                {
                                    Title = T("Admin.ContentManagement.Layouts.Fields.IsDefault").Text,
                                    Width = "100",
                                    ClassName = AssetForgeColumnClassDefaults.CenterAll,
                                    Render = new RenderBoolean(),
                                    Editable = true,
                                    EditType = EditType.Checkbox
                                },
                                new ColumnProperty(nameof(LayoutModel.IsMobile))
                                {
                                    Title = T("Admin.ContentManagement.Layouts.Fields.IsMobile").Text,
                                    Width = "100",
                                    ClassName = AssetForgeColumnClassDefaults.CenterAll,
                                    Render = new RenderBoolean(),
                                    Editable = true,
                                    EditType = EditType.Checkbox
                                },
                                new ColumnProperty(nameof(LayoutModel.IsActive))
                                {
                                    Title = T("Admin.ContentManagement.Layouts.Fields.IsActive").Text,
                                    Width = "100",
                                    ClassName = AssetForgeColumnClassDefaults.CenterAll,
                                    Render = new RenderBoolean(),
                                    Editable = true,
                                    EditType = EditType.Checkbox
                                },
                                new ColumnProperty(nameof(LayoutModel.Id))
                                {
                                    Title = T("Admin.Common.Edit").Text,
                                    Width = "80",
                                    ClassName = AssetForgeColumnClassDefaults.Button,
                                    Render = new RenderButtonEdit(new DataUrl("Edit"))
                                }
                            }
                    })
                </div>
            </div>
        </div>
    </div>
</div>
</section>