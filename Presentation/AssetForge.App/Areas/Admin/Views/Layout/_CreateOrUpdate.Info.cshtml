@model LayoutModel

<style>
    .widget-instances-card-header{
        background: #58aa99;
        color: #FFF
    }
</style>

<div class="card-body">
    <div class="form-group row" id="email-area">
        <div class="col-md-3">
            <ix-label asp-for="Name" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="Name" asp-required="true" />
            <span asp-validation-for="Name"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <ix-label asp-for="TemplateId" />
        </div>
        <div class="col-md-9">
            <ix-select asp-for="TemplateId" asp-items="Model.AvailableTemplates" asp-multiple="false" asp-required="true" />
        </div>
    </div>
    <div class="form-group row advanced-setting">
        <div class="col-md-3">
            <ix-label asp-for="SelectedSiteIds" />
        </div>
        <div class="col-md-9">
            <div class="row">
                <div class="col-md-4">
                    <ix-select asp-for="SelectedSiteIds" asp-items="Model.AvailableSites" asp-multiple="true" />
                    <script>
                        $(function () {
                            var sitesIdsInput = $('#@Html.IdFor(model => model.SelectedSiteIds)').select2({
                                closeOnSelect: false,
                        @if (!Model.AvailableSites.Any())
                        {
                            <text>
                                    disabled: true,
                                    placeholder: 'No sites available',
                            </text>
                        }
                                                                            });
                                                                        });
                    </script>
                </div>
                <div class="col-md-8">
                    @await Component.InvokeAsync(typeof(MultisiteDisabledWarningViewComponent))
                </div>
            </div>
        </div>
    </div>
    <div class="form-group row" id="display-name-area">
        <div class="col-md-3">
            <ix-label asp-for="DisplayOrder" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="DisplayOrder" />
            <span asp-validation-for="DisplayOrder"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <ix-label asp-for="IsMobile" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="IsMobile" />
            <span asp-validation-for="IsMobile"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <ix-label asp-for="IsDefault" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="IsDefault" />
            <span asp-validation-for="IsDefault"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <ix-label asp-for="IsActive" />
        </div>
        <div class="col-md-9">
            <ix-editor asp-for="IsActive" />
            <span asp-validation-for="IsActive"></span>
        </div>
    </div>
</div>

