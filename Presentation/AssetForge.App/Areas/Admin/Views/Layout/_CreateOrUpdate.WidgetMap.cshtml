@model LayoutModel


<div class="card-body">

    <div class="form-group row">
        <div class="col-md-9">
            @if (Model.Id > 0)
            {
                <div id="widget-instance-select">
                    @foreach (var cr in Model.AvailableWidgets)
                    {
                        <div class="col-md-12">
                            <label>
                                <input class="widget_@(cr.Value)" text type="checkbox" value="@(cr.Value)" name="widget_@(cr.Value)" @(cr.Selected ? "checked=\"checked\"" : null) /> @cr.Text
                            </label>
                        </div>
                    }
                </div>
                <script>
                    $(document).ready(function () {
                        $("#@Html.IdFor(model => model.TemplateId)").change(function () {

                            var selectedItem = $(this).val();
                            var ddlStates = $("#widget-instance-select");
                            $.ajax({
                                cache: false,
                                type: "GET",
                                url: "@(Url.Action("GetWidgetInstancesForLayoutByTemplateId", "Layout"))",
                                data: {
                                    "templateId": selectedItem,
                                    "layoutId": @Model.Id
                                                                                        },
                                success: function (data, textStatus, jqXHR) {
                                    ddlStates.html('');
                                    $.each(data,
                                        function (id, widget) {
                                            var checked = widget.Selected ? 'checked="checked"' : '';
                                            var html = `<div class="col-md-12">
                                                                                                <label>
                                                                                                    <input class="widget_${widget.Value}" type="checkbox" value="${widget.Value}" name="widget_${widget.Value}" ${checked} /> ${widget.Text}
                                                                                                </label>
                                                                                            </div>`;
                                            ddlStates.append(html);
                                        });
                                },
                                error: function (jqXHR, textStatus, errorThrown) {
                                    ddlStates.html('');
                                    $("#statesAlert").click();
                                }
                            });
                        });
                    });
                </script>
            }
            else
            {

                <div class="card-text">@T("Admin.ContentManagement.Layouts.Fields.WidgetInstances.SaveFirst")</div>
            }
        </div>
    </div>
</div>